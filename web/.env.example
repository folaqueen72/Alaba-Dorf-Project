# Copy to .env (never commit .env). Money is stored in kobo (integer) in the DB.
# Local dev uses DATABASE_URL. On Netlify, the Neon integration injects
# NETLIFY_DATABASE_URL automatically and the app picks it up — no change needed.
DATABASE_URL="postgresql://alaba:alaba@localhost:5432/alaba"

# Better Auth — generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET="change-me-in-production"
BETTER_AUTH_URL="http://localhost:3000"

# Cloudflare R2 (S3-compatible) — files/storage + image origin
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="alaba-dorf"
R2_PUBLIC_URL="https://files.example.com"

# Resend — transactional email (order/booking confirmations, resets, digests)
RESEND_API_KEY=""
EMAIL_FROM="Alaba Dorf <orders@example.com>"

# Paystack — online payment (test keys for dev)
PAYSTACK_PUBLIC_KEY=""
PAYSTACK_SECRET_KEY=""
